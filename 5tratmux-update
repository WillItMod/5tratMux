power_off_error() {
  write_status "failed" "$1" "" || true
  printf '5tratMux updater: %s\n' "$1" >&2
  return 1
}

hold_powered_off() {
  local installed observed proof names
  installed="$(installed_version)"
  if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    docker update --restart=no "${CONTAINER_NAME}" >/dev/null \
      || { power_off_error "could not preserve the powered-off restart policy"; return 1; }
    docker stop --time 20 "${CONTAINER_NAME}" >/dev/null \
      || { power_off_error "could not stop 5tratMux while preserving power Off"; return 1; }
    observed="$(docker container inspect --format '{{json .}}' "${CONTAINER_NAME}")" \
      || { power_off_error "could not verify the powered-off container"; return 1; }
    proof="$(python3 - "${observed}" "${CONTAINER_NAME}" <<'PYOFF'
import json, re, sys
value = json.loads(sys.argv[1])
state = value.get("State") or {}
identity, image = value.get("Id"), value.get("Image")
policy = (value.get("HostConfig") or {}).get("RestartPolicy") or {}
assert re.fullmatch(r"[0-9a-f]{64}", identity or "")
assert re.fullmatch(r"sha256:[0-9a-f]{64}", image or "")
assert state.get("Running") is False and state.get("Restarting") is False
assert state.get("Paused") is False and state.get("Dead") is False
assert state.get("Status") in {"created", "exited"} and policy.get("Name") == "no"
print(json.dumps({"desired":"off", "verified":True, "containerPresent":True,
                  "containerName":sys.argv[2], "containerId":identity, "imageId":image, "running":False,
                  "restartPolicy":"no"}, separators=(",", ":")))
PYOFF
)" || { power_off_error "powered-off container state could not be verified"; return 1; }
  else
    # An inspect error alone does not establish absence (the daemon may be down).
    names="$(docker container ls --all --format '{{.Names}}')" \
      || { power_off_error "could not verify that the powered-off container is absent"; return 1; }
    if printf '%s\n' "${names}" | grep -Fxq "${CONTAINER_NAME}"; then
      power_off_error "could not inspect the existing powered-off container"; return 1
    fi
    proof="$(python3 - "${CONTAINER_NAME}" <<'PYABSENT'
import json, sys
print(json.dumps({"desired":"off", "verified":True, "containerPresent":False,
                  "containerName":sys.argv[1], "containerId":None, "imageId":None,
                  "running":False, "restartPolicy":None}, separators=(",", ":")))
PYABSENT
)" || { power_off_error "could not record the absent powered-off container"; return 1; }
  fi
  [[ "${1:-}" != "verify-only" ]] || return 0
  write_status \
    "powered_off" \
    "5tratMux is powered off by 5tratumOS; settings, licence and saved routes are preserved" \
    "${installed}" "${proof}"
}

enable_watchdog_service() {
  if ! command -v systemctl >/dev/null 2>&1 \
    || ! systemctl cat 5tratmux-watchdog.service >/dev/null 2>&1; then
    return 0
  fi
  systemctl enable 5tratmux-watchdog.service >/dev/null 2>&1 || true
  systemctl start --no-block 5tratmux-watchdog.service >/dev/null 2>&1 || true
}

die() {
  write_status "failed" "$*" "" || true
  printf '5tratMux updater: %s\n' "$*" >&2
  exit 1
}

require_root() {
  [[ "$(id -u)" -eq 0 ]] || die "run this command with sudo"
}

with_lifecycle_lock() (
  # Shared with OS-owned DNS changes. Do not overwrite another operation's
  # status when it holds this lock, and do not retain it between watchdog polls.
  # A supervised OS bundle handoff must survive a watchdog already starting
  # the old app. Interactive actions and watchdog polls remain nonblocking.
  local lock_args=(--nonblock)
  if [[ "${1:-}" = "--wait-bundle" ]]; then
    shift
    local wait_seconds="${MUX_BUNDLE_LOCK_WAIT_SECONDS:-300}"
    if [[ ! "${wait_seconds}" =~ ^[1-9][0-9]{0,2}$ ]] || (( wait_seconds > 600 )); then
      printf '5tratMux: bundle lock wait must be between 1 and 600 seconds.\n' >&2
      exit 2
    fi
    lock_args=(--timeout "${wait_seconds}")
    printf '5tratMux: waiting up to %s seconds for the update/DNS lifecycle lock.\n' "${wait_seconds}" >&2
  fi
  require_root
  command -v flock >/dev/null 2>&1 || die "required command is missing: flock"
  umask 077
  mkdir -p "$(dirname "${LIFECYCLE_LOCK_FILE}")"
  exec 9>"${LIFECYCLE_LOCK_FILE}"
  if ! flock "${lock_args[@]}" 9; then
    printf '5tratMux: another update or DNS change is in progress; retry when it finishes.\n' >&2
    exit 75
  fi
  if ! python3 - "${DNS_OPERATION_FILE}" <<'PY'
import json
import os
import sys
try:
    if os.path.exists(sys.argv[1]):
        with open(sys.argv[1], encoding="utf-8") as handle:
            state = json.load(handle)
        if not isinstance(state, dict) or state.get("applying") or state.get("rollback") == "requires_inspection":
            raise ValueError("unfinished DNS change")
except (OSError, ValueError, TypeError):
    print("5tratMux: an unresolved DNS change needs attention before another update or restart.", file=sys.stderr)
    sys.exit(1)
PY
  then
    exit 75
  fi
  "$@"
)

require_commands() {
  local command_name
  for command_name in curl docker openssl python3 sha256sum; do
    command -v "${command_name}" >/dev/null 2>&1 \
      || die "required command is missing: ${command_name}"
  done
}

architecture() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'amd64\n' ;;
    aarch64|arm64) printf 'arm64\n' ;;
    *) die "unsupported CPU architecture: $(uname -m)" ;;
  esac
}

version_key() {
  python3 - "$1" <<'PY'
import re
import sys
value = sys.argv[1].strip()
match = re.match(r"^\s*v?(\d+(?:\.\d+)*)(?:[-+](.*))?\s*$", value)
if not match:
    print("000000000.000000000.000000000.0.000000000")
    raise SystemExit
parts = [int(token) for token in match.group(1).split(".")]
parts = (parts + [0, 0, 0])[:3]
suffix = (match.group(2) or "").strip().lower()
if not suffix:
    rank = 5
elif suffix.startswith("rc"):
    rank = 4
elif "beta" in suffix:
    rank = 3
elif "alpha" in suffix:
    rank = 2
else:
    rank = 1
suffix_number = re.search(r"(\d+)", suffix)
suffix_number = int(suffix_number.group(1)) if suffix_number else 0
print(
    ".".join(f"{part:09d}" for part in parts)
    + f".{rank}.{suffix_number:09d}"
)
PY
}

write_public_key() {
  install -d -m 0755 "${RUNTIME_DIR}"
  printf '%s\n' "${PUBLIC_KEY_PEM}" > "${PUBLIC_KEY_FILE}"
  chmod 0644 "${PUBLIC_KEY_FILE}"
  local fingerprint
  fingerprint="$(
    openssl pkey -pubin -in "${PUBLIC_KEY_FILE}" -outform DER 2>/dev/null \
      | openssl dgst -sha256 \
      | awk '{print $NF}'
  )"
  [[ "${fingerprint}" = "${PUBLIC_KEY_FINGERPRINT}" ]] \
    || die "the embedded update key failed its fingerprint check"
}

download_manifest() {
  local directory="$1"
  local manifest_status installed
  if ! manifest_status="$(
    curl --silent --show-error --location \
      --connect-timeout "${CURL_CONNECT_TIMEOUT}" --max-time "${MANIFEST_MAX_TIME}" \
      --output "${directory}/manifest.json" \
      --write-out '%{http_code}' \
      "${MANIFEST_URL}"
  )"; then
    die "the signed release channel could not be reached; the installed version was not changed"
  fi
  if [[ "${manifest_status}" = "404" ]]; then
    installed="$(installed_version)"
    write_status \
      "current" \
      "No signed 5tratMux update has been published yet; ${installed} remains installed" \
      "${installed}"
    printf 'No signed 5tratMux update has been published yet. Installed version %s was not changed.\n' \
      "${installed}"
    exit 0
  fi
  [[ "${manifest_status}" =~ ^2[0-9][0-9]$ ]] \
    || die "the signed release channel returned HTTP ${manifest_status}; the installed version was not changed"
  if ! curl --fail --silent --show-error --location \
    --connect-timeout "${CURL_CONNECT_TIMEOUT}" --max-time "${MANIFEST_MAX_TIME}" \
    "${SIGNATURE_URL}" -o "${directory}/manifest.sig"; then
    die "the signed release signature is unavailable; the installed version was not changed"
  fi
  verify_manifest "${directory}"
}

verify_manifest() {
  local directory="$1"
  openssl pkeyutl \
    -verify \
    -pubin \
    -inkey "${PUBLIC_KEY_FILE}" \
    -rawin \
    -in "${directory}/manifest.json" \
    -sigfile "${directory}/manifest.sig" >/dev/null \
    || die "release manifest signature verification failed"
}

bundled_manifest() {
  local source="$1" work="$2" name
  for name in 5tratmux-release.json 5tratmux-release.json.sig; do
    [[ -f "${source}/${name}" && ! -L "${source}/${name}" ]] \
      || die "bundled release is missing a regular ${name}; the installed version was not changed"
  done
  cp "${source}/5tratmux-release.json" "${work}/manifest.json"
  cp "${source}/5tratmux-release.json.sig" "${work}/manifest.sig"
  verify_manifest "${work}"
}

