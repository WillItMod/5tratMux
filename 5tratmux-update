#!/usr/bin/env bash
set -Eeuo pipefail

# Root-owned deployments may override the signed release endpoint for a private
# validation channel. Public installations do not need this file and continue
# to use the pinned GitHub release channel below.
UPDATER_ENV_FILE="${MUX_UPDATER_ENV_FILE:-/etc/5tratumos/5tratmux-updater.env}"
orphaned_public_handoff_pin() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "${UPDATER_ENV_FILE}" "${MUX_OS_HANDOFF_MARKER:-/opt/5tratumos/bootstrap/5tratmux-post-update-required.json}" <<'PY'
from pathlib import Path
import re
import sys

feed, marker = map(Path, sys.argv[1:])
try:
    # A pending handoff (including a broken link) retains its exact release.
    try:
        marker.lstat()
    except FileNotFoundError:
        pass
    else:
        sys.exit(1)
    if feed.is_symlink():
        sys.exit(1)
    with feed.open(encoding="utf-8") as stream:
        body = stream.read(4097)
    pattern = (r"# Managed by 5tratumOS update handoff\n"
               r"MUX_MANIFEST_URL=(https://github\.com/WillItMod/5tratMux/releases/download/"
               r"v[0-9]+\.[0-9]+\.[0-9]+/5tratmux-release\.json)\n"
               r"MUX_SIGNATURE_URL=\1\.sig\n?")
    sys.exit(0 if re.fullmatch(pattern, body) else 1)
except (OSError, UnicodeError):
    sys.exit(1)
PY
}
if [[ -r "${UPDATER_ENV_FILE}" ]]; then
  if orphaned_public_handoff_pin; then
    printf 'Ignoring an orphaned OS handoff release pin; checking the public signed release channel.\n' >&2
  else
    # Private/operator feeds and active OS handoffs remain authoritative.
    # shellcheck disable=SC1090
    source "${UPDATER_ENV_FILE}"
  fi
fi

# shellcheck disable=SC2034  # descriptive constant retained for operators
PRODUCT="5tratMux"
CONTAINER_NAME="${MUX_CONTAINER_NAME:-5tratmux}"
STATE_DIR="${MUX_STATE_DIR:-/var/lib/5tratumos/5tratmux}"
CONFIG_DIR="${MUX_CONFIG_DIR:-/etc/5tratumos}"
CONFIG_FILE="${MUX_CONFIG_FILE:-${CONFIG_DIR}/5tratmux.env}"
DNS_CONFIG_FILE="${MUX_DNS_CONFIG_FILE:-${CONFIG_DIR}/5tratmux-dns.json}"
LIFECYCLE_LOCK_FILE="${MUX_LIFECYCLE_LOCK_FILE:-/run/lock/5tratmux-lifecycle.lock}"
DNS_OPERATION_FILE="${MUX_DNS_OPERATION_FILE:-/var/lib/5tratumos/mux-dns-apply.json}"
CONTROLLER_TOKEN_FILE="${MUX_CONTROLLER_TOKEN_FILE:-${CONFIG_DIR}/5tratmux-controller.token}"
RUNTIME_DIR="${MUX_RUNTIME_DIR:-/var/lib/5tratumos/5tratmux-updater}"
STATUS_FILE="${MUX_STATUS_FILE:-${RUNTIME_DIR}/status.json}"
POWER_STATE_FILE="${MUX_POWER_STATE_FILE:-/var/lib/5tratumos/5tratmux-power.json}"
PUBLIC_KEY_FILE="${RUNTIME_DIR}/update-signing-public.pem"
DEFAULT_MANIFEST_URL="https://github.com/WillItMod/5tratMux/releases/latest/download/5tratmux-release.json"
MANIFEST_URL="${MUX_MANIFEST_URL:-${DEFAULT_MANIFEST_URL}}"
SIGNATURE_URL="${MUX_SIGNATURE_URL:-${MANIFEST_URL}.sig}"
LICENSING_URL="${MUX_LICENSING_URL:-https://5tratum.com/licensing}"
MUX_DNS_PRIMARY="${MUX_DNS_PRIMARY:-1.1.1.1}"
MUX_DNS_SECONDARY="${MUX_DNS_SECONDARY:-8.8.8.8}"
LICENSING_PUBLIC_KEY="I_aujMd069Ki6ZYDw-qhQDQWM0JX5ymizbg7pqVakkE"
HEALTH_URL="${MUX_HEALTH_URL:-http://127.0.0.1:21222/api/health}"
HEALTH_ATTEMPTS="${MUX_HEALTH_ATTEMPTS:-120}"
# Overall bound for one post-install health wait, independent of probe count.
HEALTH_DEADLINE_SECONDS="${MUX_HEALTH_DEADLINE_SECONDS:-300}"
# Every network request is bounded so a stalled peer cannot hold the
# lifecycle lock (and the busy status) indefinitely.
CURL_CONNECT_TIMEOUT="${MUX_CURL_CONNECT_TIMEOUT:-15}"
MANIFEST_MAX_TIME="${MUX_MANIFEST_MAX_TIME:-60}"
DOWNLOAD_MAX_TIME="${MUX_DOWNLOAD_MAX_TIME:-1800}"
HIGHEST_VERSION_FILE="${RUNTIME_DIR}/highest-installed-version"
# Set only by the explicit --allow-downgrade CLI flag.
ALLOW_DOWNGRADE=0
UPDATER_WORK_DIR=""
UPDATER_STATUS_BUSY=0
WATCHDOG_STATE_DIR="${MUX_WATCHDOG_STATE_DIR:-/var/lib/5tratumos/5tratmux-watchdog}"
WATCHDOG_INTERVAL="${MUX_WATCHDOG_INTERVAL:-120}"
WATCHDOG_REINSTALL_COOLDOWN="${MUX_WATCHDOG_REINSTALL_COOLDOWN:-3600}"
PUBLIC_KEY_FINGERPRINT="1d5901e7c64046d15fcdee8c0b1c962d6f946d4a620d2be2765fbb23c0673ddf"

PUBLIC_KEY_PEM='-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEA6yiFKOdJV9Sn/yk97iuV/gGQD8A/PC8CZczr37eY1hY=
-----END PUBLIC KEY-----'

# Developer preview boxes deliberately retain their preview container name.
# Public installations use ``5tratmux``. Detecting the preview locally keeps
# the same signed updater testable without changing or duplicating state.
if [[ -z "${MUX_CONTAINER_NAME:-}" ]] \
  && command -v docker >/dev/null 2>&1 \
  && ! docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1 \
  && docker container inspect 5tratmux-preview >/dev/null 2>&1; then
  CONTAINER_NAME="5tratmux-preview"
fi

write_status() {
  local phase="${1:-idle}"
  local message="${2:-}"
  local version="${3:-}"
  local power="${4:-}"
  case "${phase}" in
    checking|downloading|installing|rolling_back)
      UPDATER_STATUS_BUSY=1
      # Any exit while busy (set -e failure, signal) must clear the busy flag.
      trap updater_exit_trap EXIT
      ;;
    *) UPDATER_STATUS_BUSY=0 ;;
  esac
  if ! command -v python3 >/dev/null 2>&1; then
    return 0
  fi
  install -d -m 0755 "${RUNTIME_DIR}" || return 1
  python3 - "${STATUS_FILE}" "${phase}" "${message}" "${version}" "${power}" "${MUX_UPDATE_OPERATION_ID:-}" "${MUX_UPDATE_RESULT_FILE:-${RUNTIME_DIR}/os-update-status.json}" <<'PY'
import json
import os
import sys
import tempfile
from datetime import datetime, timezone

path, phase, message, version, power, operation_id, result_path = sys.argv[1:]
payload = {
    "phase": phase,
    "message": message,
    "version": version,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "busy": phase in {"checking", "downloading", "installing", "rolling_back"},
}

if operation_id:
    import re
    if not re.fullmatch(r"[0-9a-f]{32}", operation_id):
        raise ValueError("invalid update operation ID")
    payload["operationId"] = operation_id
if power:
    payload["power"] = json.loads(power)

def atomic_write(destination):
    directory = os.path.dirname(destination)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".5tratmux-update-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, destination)
        parent = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

atomic_write(path)
# A later watchdog/bootstrap invocation must not overwrite the OS operation's
# result. One fixed receipt is replaced only by an explicitly identified run.
if operation_id:
    atomic_write(result_path)

PY
}

updater_exit_trap() {
  local rc=$?
  if [[ -n "${UPDATER_WORK_DIR}" ]]; then
    rm -rf -- "${UPDATER_WORK_DIR}" || true
    UPDATER_WORK_DIR=""
  fi
  # A die() inside a command substitution already recorded its own failure;
  # only replace a status that still claims this run is busy.
  if (( rc != 0 )) && [[ "${UPDATER_STATUS_BUSY}" = 1 ]] && updater_busy; then
    write_status "failed" "The 5tratMux updater stopped before finishing (exit ${rc}); check 5tratMux status and retry" "" || true
  fi
  return "${rc}"
}

new_work_dir() {
  cleanup_work_dir
  # mktemp -d creates a private (0700) directory owned by the caller.
  UPDATER_WORK_DIR="$(mktemp -d)"
  trap updater_exit_trap EXIT
}

cleanup_work_dir() {
  if [[ -n "${UPDATER_WORK_DIR}" ]]; then
    rm -rf -- "${UPDATER_WORK_DIR}"
    UPDATER_WORK_DIR=""
  fi
}

power_desired_on() {
  [[ ! -r "${POWER_STATE_FILE}" ]] && return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "${POWER_STATE_FILE}" <<'PY' >/dev/null 2>&1
import json
import sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        desired = str(json.load(handle).get("desired") or "on").strip().lower()
except Exception:
    desired = "on"
raise SystemExit(0 if desired != "off" else 1)
