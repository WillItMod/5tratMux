installed_version() {
  if ! docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    printf 'not-installed\n'
    return
  fi
  local value
  value="$(
    docker container inspect \
    --format '{{index .Config.Labels "org.opencontainers.image.version"}}' \
    "${CONTAINER_NAME}" 2>/dev/null \
      | sed '/^<no value>$/d'
  )"
  if [[ -z "${value}" ]]; then
    value="$(
      docker container inspect \
        --format '{{range .Config.Env}}{{println .}}{{end}}' \
        "${CONTAINER_NAME}" 2>/dev/null \
        | sed -n 's/^APP_VERSION=//p' \
        | tail -n 1
    )"
  fi
  if [[ -z "${value}" ]]; then
    value="$(
      docker container inspect \
        --format '{{.Config.Image}}' \
        "${CONTAINER_NAME}" 2>/dev/null \
        | sed 's/^.*://'
    )"
  fi
  printf '%s\n' "${value:-unknown}"
}

detect_host_ip() {
  local host_ip
  host_ip="$(
    ip -4 route get 1.1.1.1 2>/dev/null \
      | awk '{for (i=1; i<=NF; i++) if ($i=="src") {print $(i+1); exit}}'
  )"
  if [[ -z "${host_ip}" || "${host_ip}" = 127.* || "${host_ip}" = 169.254.* ]]; then
    host_ip="$(
      ip -o -4 addr show scope global 2>/dev/null \
        | awk '$2 !~ /^(lo|docker0|br-|veth|tailscale)/ {split($4, a, "/"); if (a[1] !~ /^(127\.|169\.254\.)/) {print a[1]; exit}}'
    )"
  fi
  if [[ "${host_ip}" = 127.* || "${host_ip}" = 169.254.* ]]; then
    host_ip=""
  fi
  printf '%s\n' "${host_ip}"
}

refresh_public_host_config() {
  # Refresh the advertised host and add the pinned licensing key when it is
  # missing. Other lines, including APP_HOST, are preserved.
  local host_ip="$1"
  python3 - "${CONFIG_FILE}" "${host_ip}" "${LICENSING_PUBLIC_KEY}" <<'PY'
import os
import sys
import tempfile

path, host_ip, licensing_key = sys.argv[1:]
with open(path, "r", encoding="utf-8") as handle:
    original = handle.read()
lines = original.splitlines()
updated = []
found = False
has_licensing_key = False
for line in lines:
    if host_ip and line.startswith("APP_PUBLIC_HOST="):
        updated.append(f"APP_PUBLIC_HOST={host_ip}")
        found = True
    else:
        if line.startswith("MUX_LICENSING_PUBLIC_KEY=") and line.split("=", 1)[1].strip():
            has_licensing_key = True
        updated.append(line)
if host_ip and not found:
    updated.append(f"APP_PUBLIC_HOST={host_ip}")
if not has_licensing_key:
    updated = [line for line in updated if not line.startswith("MUX_LICENSING_PUBLIC_KEY=")]
    updated.append(f"MUX_LICENSING_PUBLIC_KEY={licensing_key}")
if "\n".join(updated) + "\n" == original:
    sys.exit(0)
directory = os.path.dirname(path) or "."
fd, temporary = tempfile.mkstemp(prefix=".5tratmux-env-", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write("\n".join(updated) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}

ensure_config() {
  install -d -m 0755 "${CONFIG_DIR}"
  install -d -m 0700 "${STATE_DIR}"
  chown 0:0 "${STATE_DIR}"
  if [[ ! -s "${CONTROLLER_TOKEN_FILE}" ]]; then
    umask 077
    if command -v openssl >/dev/null 2>&1; then
      openssl rand -base64 48 > "${CONTROLLER_TOKEN_FILE}"
    else
      python3 - "${CONTROLLER_TOKEN_FILE}" <<'PY'
import secrets
import sys
with open(sys.argv[1], "w", encoding="utf-8") as handle:
    handle.write(secrets.token_urlsafe(48) + "\n")
PY
    fi
  fi
  chown 0:0 "${CONTROLLER_TOKEN_FILE}"
  chmod 0600 "${CONTROLLER_TOKEN_FILE}"
  local host_ip
  host_ip="$(detect_host_ip)"
  if [[ -s "${CONFIG_FILE}" ]]; then
    refresh_public_host_config "${host_ip}"
    chmod 0600 "${CONFIG_FILE}"
    return
  fi
  host_ip="${host_ip:-127.0.0.1}"
  {
    printf 'APP_HOST=0.0.0.0\n'
    printf 'APP_PORT=21222\n'
    printf 'APP_CHANNEL=MAIN\n'
    printf 'APP_PUBLIC_HOST=%s\n' "${host_ip}"
    printf 'MUX_UPSTREAM_HOST=127.0.0.1\n'
    printf 'MUX_LICENSING_URL=%s\n' "${LICENSING_URL}"
    printf 'MUX_LICENSING_PUBLIC_KEY=%s\n' "${LICENSING_PUBLIC_KEY}"
  } > "${CONFIG_FILE}"
  chmod 0600 "${CONFIG_FILE}"
}

configured_dns_servers() {
  # DNS is separate from the release-channel environment file so an OS/MUX
  # update cannot discard the user's resolver choice. Never source this JSON.
  python3 - "${DNS_CONFIG_FILE}" "${MUX_DNS_PRIMARY}" "${MUX_DNS_SECONDARY}" <<'PY'
import ipaddress
import json
import os
import sys

try:
    path, primary, secondary = sys.argv[1:]
    servers = [primary, secondary]
    if os.path.exists(path):
        with open(path, encoding="utf-8") as handle:
            settings = json.load(handle)
        if not isinstance(settings, dict) or settings.get("mode") not in {"default", "custom"}:
            raise ValueError("invalid mode")
        servers = ["1.1.1.1", "8.8.8.8"] if settings["mode"] == "default" else settings.get("servers")
    if not isinstance(servers, list) or not 1 <= len(servers) <= 3:
        raise ValueError("invalid DNS server count")
    result = []
    for value in servers:
        if not isinstance(value, str) or not value or value != value.strip() or "%" in value:
            raise ValueError("invalid DNS address")
        address = ipaddress.ip_address(value)
        if address.is_unspecified or address.is_multicast or str(address) == "255.255.255.255":
            raise ValueError("invalid DNS address")
        normalized = str(address)
        if normalized not in result:
            result.append(normalized)
    print("\n".join(result))
except (ValueError, TypeError, OSError):
    print("Invalid saved 5tratMux DNS settings; correct the DNS configuration before updating.", file=sys.stderr)
    sys.exit(1)
PY
}

container_mounts() {
  local candidate destination
  while IFS='|' read -r candidate destination; do
    if [[ -e "${candidate}" ]]; then
      printf -- '--mount\ntype=bind,src=%s,dst=%s,readonly\n' \
        "${candidate}" "${destination}"
    fi
  done <<'EOF'
/etc/5tratumos/5tratmux-controller.token|/run/5tratumos/5tratmux-controller-token
/etc/machine-id|/run/5tratumos/machine-id
/var/lib/5tratumos/support/install_id.txt|/run/5tratumos/install-id
/var/lib/5tratumos/support/licensing_identity.json|/run/5tratumos/licensing-identity.json
EOF
}

container_from_image() {
  local image="$1"
  local release_channel="$2"
  local action="$3" restart="$4"
  local -a action_args=("${action}")
  [[ "$action" != "run" ]] || action_args+=(--detach)
  local dns_values
  local -a mounts=() dns_args=()
  dns_values="$(configured_dns_servers)" || return 1
  while IFS= read -r line; do
    dns_args+=(--dns "${line}")
  done <<< "${dns_values}"
  while IFS= read -r line; do
    mounts+=("${line}")
  done < <(container_mounts)
  docker "${action_args[@]}" \
    --name "${CONTAINER_NAME}" \
    --network host \
    "${dns_args[@]}" \
    --restart "${restart}" \
    --read-only \
    --tmpfs "/tmp:rw,exec,nosuid,nodev,size=256m" \
    --pids-limit 256 \
    --security-opt no-new-privileges:true \
    --cap-drop ALL \
    --env-file "${CONFIG_FILE}" \
    --env "APP_CHANNEL=${release_channel}" \
    --mount "type=bind,src=${STATE_DIR},dst=/data/ui/state" \
    "${mounts[@]}" \
    "${image}" >/dev/null
}

start_container() { container_from_image "$1" "$2" run unless-stopped; }
create_stopped_container() { container_from_image "$1" "$2" create no; }

activate_release() {
  if power_desired_on; then
    start_container "$1" "$2" && wait_for_health
  else
    create_stopped_container "$1" "$2" && hold_powered_off verify-only
  fi
}

wait_for_health() {
  local attempt deadline
  if [[ ! "${HEALTH_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]]; then
    HEALTH_ATTEMPTS=120
  fi
  if [[ ! "${HEALTH_DEADLINE_SECONDS}" =~ ^[1-9][0-9]*$ ]]; then
    HEALTH_DEADLINE_SECONDS=300
  fi
  deadline=$((SECONDS + HEALTH_DEADLINE_SECONDS))
  for ((attempt = 1; attempt <= HEALTH_ATTEMPTS; attempt++)); do
    if curl --fail --silent --show-error --connect-timeout 2 --max-time 5 \
      "${HEALTH_URL}" >/dev/null 2>&1; then
      return 0
    fi
    (( SECONDS < deadline )) || return 1
    sleep 1
  done
  return 1
}

# The highest release this device has run. Older signed manifests are refused
# even when the container is missing or unlabelled, unless the operator passes
# --allow-downgrade (an explicit --rollback uses the retained local image).
recorded_version_floor() {
  local file value best="" best_key="" key
  for file in "${HIGHEST_VERSION_FILE}" "${RUNTIME_DIR}/installed-version"; do
    [[ -f "${file}" && ! -L "${file}" ]] || continue
    value="$(head -n 1 "${file}" 2>/dev/null || true)"
    [[ "${value}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]] || continue
    key="$(version_key "${value}")"
    if [[ -z "${best}" || "${key}" > "${best_key}" ]]; then
      best="${value}"
      best_key="${key}"
    fi
  done
  printf '%s\n' "${best}"
}

record_installed_version() {
  local version="$1" floor
  install -d -m 0755 "${RUNTIME_DIR}"
  printf '%s\n' "${version}" > "${RUNTIME_DIR}/installed-version"
  floor="$(recorded_version_floor)"
  if [[ "${ALLOW_DOWNGRADE}" = 1 || -z "${floor}" ]] \
    || [[ "$(version_key "${version}")" > "$(version_key "${floor}")" ]]; then
    floor="${version}"
  fi
  printf '%s\n' "${floor}" > "${HIGHEST_VERSION_FILE}.tmp"
  mv -f "${HIGHEST_VERSION_FILE}.tmp" "${HIGHEST_VERSION_FILE}"
}

# Containers set aside by an install/rollback that was interrupted (power loss,
# SIGKILL) before the replacement became current. Newest name sorts last.
previous_containers() {
  local name prefix="${CONTAINER_NAME}-previous-"
  while IFS= read -r name; do
    [[ "${name}" == "${prefix}"* && "${name#"${prefix}"}" =~ ^[0-9]+$ ]] || continue
    printf '%s %s\n' "${name#"${prefix}"}" "${name}"
  done | sort -n | awk '{print $2}'
}

restore_interrupted_install() {
  local names newest
  if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    return 0
  fi
  # An inspect error alone does not establish absence (the daemon may be down).
  names="$(docker container ls --all --format '{{.Names}}')" \
    || die "could not list containers to check for an interrupted update"
  if printf '%s\n' "${names}" | grep -Fxq "${CONTAINER_NAME}"; then
    die "could not inspect the existing 5tratMux container"
  fi
  newest="$(printf '%s\n' "${names}" | previous_containers | tail -n 1)"
  [[ -n "${newest}" ]] || return 0
  printf 'Restoring %s left by an interrupted 5tratMux update.\n' "${newest}" >&2
  docker rename "${newest}" "${CONTAINER_NAME}" \
    || die "could not restore ${newest} left by an interrupted update"
  if power_desired_on; then
    docker update --restart=unless-stopped "${CONTAINER_NAME}" >/dev/null \
      || die "could not restore the restart policy of the recovered container"
    docker start "${CONTAINER_NAME}" >/dev/null \
      || die "the container recovered from an interrupted update could not be started"
  fi
}

# Undo a failed replacement: remove the new container and restore the one set
# aside as ${backup_name}, preserving the desired power state.
restore_previous_container() {
  local backup_name="$1" label="$2" remaining
  if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    docker container rm --force "${CONTAINER_NAME}" >/dev/null 2>&1 \
      || die "${label} failed; could not remove its container for restoration"
  else
    remaining="$(docker container ls --all --format '{{.Names}}')" \
      || die "${label} failed; could not check container state before restoration"
    if printf '%s\n' "${remaining}" | grep -Fxq "${CONTAINER_NAME}"; then
      die "${label} failed; could not inspect its container before restoration"
    fi
  fi
  [[ -n "${backup_name}" ]] || return 0
  docker rename "${backup_name}" "${CONTAINER_NAME}" \
    || die "${label} failed; could not restore the previous container name"
  if power_desired_on; then
    docker start "${CONTAINER_NAME}" >/dev/null \
      || die "${label} failed; previous container could not be started"
  else
    hold_powered_off verify-only || return 1
  fi
}

install_release() {
  local bundle="${1:-}"
  require_root
  require_commands
  write_public_key
  ensure_config
  configured_dns_servers >/dev/null || die "saved DNS settings are invalid; the installed version was not changed"
  # A previous run interrupted between setting the old container aside and
  # activating its replacement must be repaired before anything is fetched.
  restore_interrupted_install

  local work arch version channel image url digest archive current_image backup_name
  local installed installed_key available_key floor
  new_work_dir
  work="${UPDATER_WORK_DIR}"
  write_status "checking" "Verifying the signed release manifest" ""
  if [[ -n "${bundle}" ]]; then
    bundled_manifest "${bundle}" "${work}"
  else
    download_manifest "${work}"
  fi
  arch="$(architecture)"
  version="$(manifest_value "${work}/manifest.json" version)"
  channel="$(manifest_value "${work}/manifest.json" channel)"
  [[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]] \
    || die "signed release version is invalid"
  [[ "${channel}" = "MAIN" ]] \
    || die "signed public releases must declare the MAIN channel"
  installed="$(installed_version)"
  installed_key="$(version_key "${installed}")"
  available_key="$(version_key "${version}")"
  if [[ -n "${installed}" && (
    "${installed_key}" = "${available_key}"
    || ( "${installed_key}" > "${available_key}" && "${ALLOW_DOWNGRADE}" != 1 )
  ) ]]; then
    if power_desired_on; then
      write_status \
        "current" \
        "Installed 5tratMux ${installed} is not older than signed release ${version}; no downgrade was performed" \
        "${installed}"
    else
      hold_powered_off || return 1
    fi
    enable_watchdog_service
    cleanup_work_dir
    printf '5tratMux %s was preserved; signed release %s is not newer.\n' "${installed}" "${version}"
    return 0
  fi
  # The container may be missing or unlabelled; the recorded floor still
  # prevents a replayed older signed manifest from being installed.
  floor="$(recorded_version_floor)"
  if [[ "${ALLOW_DOWNGRADE}" != 1 && -n "${floor}" ]] \
    && [[ "$(version_key "${floor}")" > "${available_key}" ]]; then
    die "signed release ${version} is older than previously installed 5tratMux ${floor}; refusing the downgrade (use --allow-downgrade or --rollback deliberately)"
  fi
  image="$(manifest_value "${work}/manifest.json" "images.${arch}.image")"
  url="$(manifest_value "${work}/manifest.json" "images.${arch}.url")"
  digest="$(manifest_value "${work}/manifest.json" "images.${arch}.sha256")"
  archive="${work}/5tratmux.oci.tar.gz"

  [[ "${digest}" =~ ^[0-9a-f]{64}$ ]] || die "signed archive checksum is invalid"
  if [[ -n "${bundle}" ]]; then
    # Derive the filename from the verified version, never a manifest URL/path.
    local bundled_archive="${bundle}/5tratmux-${version}-${arch}.oci.tar.gz"
    [[ -f "${bundled_archive}" && ! -L "${bundled_archive}" ]] \
      || die "the bundled ${arch} archive is missing; the installed version was not changed"
    write_status "installing" "Verifying bundled 5tratMux ${version} for ${arch}" "${version}"
    printf 'Installing bundled 5tratMux %s for %s without a download...\n' "${version}" "${arch}"
    # Hash and load one private copy so the bundle cannot change in between.
    cp -- "${bundled_archive}" "${archive}" \
      || die "the bundled ${arch} archive could not be copied; the installed version was not changed"
  else
    write_status "downloading" "Downloading and verifying 5tratMux ${version} for ${arch}" "${version}"
    printf 'Downloading 5tratMux %s for %s...\n' "${version}" "${arch}"
    curl --fail --silent --show-error --location \
      --connect-timeout "${CURL_CONNECT_TIMEOUT}" --max-time "${DOWNLOAD_MAX_TIME}" \
      "${url}" -o "${archive}" \
      || die "the signed ${arch} archive could not be downloaded; the installed version was not changed"
  fi
  printf '%s  %s\n' "${digest}" "${archive}" | sha256sum --check --status \
    || die "OCI archive checksum verification failed"
  docker load --input "${archive}" >/dev/null || die "verified archive could not be loaded"
  docker image inspect "${image}" >/dev/null \
    || die "verified archive did not contain ${image}"

  write_status "installing" "Installing 5tratMux ${version}; settings and licence state are preserved" "${version}"
  current_image=""
  if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    current_image="$(
      docker container inspect --format '{{.Image}}' "${CONTAINER_NAME}"
    )"
    docker image tag "${current_image}" 5tratmux:rollback \
      || die "could not retain the current image for rollback"
    docker stop "${CONTAINER_NAME}" >/dev/null \
      || die "could not stop the previous container; installation was not applied"
    backup_name="${CONTAINER_NAME}-previous-$(date +%s)"
    docker rename "${CONTAINER_NAME}" "${backup_name}" \
      || die "could not preserve the previous container for restoration"
  else
    backup_name=""
  fi

  if ! activate_release "${image}" "${channel}"; then
    restore_previous_container "${backup_name}" "new release" || return 1
    if [[ -n "${backup_name}" ]]; then
      die "new release failed its runtime verification; the previous release was restored without changing desired power"
    fi
    die "new release failed its runtime verification; no previous container was available to restore"
  fi

  if [[ -n "${backup_name}" ]]; then
    docker container rm "${backup_name}" >/dev/null
  fi
  local updater_source updater_target
  updater_target="/usr/local/sbin/5tratmux-update"
  updater_source="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  if [[ "${updater_source}" != "${updater_target}" ]]; then
    install -m 0755 "$0" "${updater_target}"
  fi
  record_installed_version "${version}"
  cleanup_work_dir
  if power_desired_on; then
    write_status "healthy" "5tratMux ${version} is healthy; licence and trial state were unchanged" "${version}"
  else
    hold_powered_off || return 1
  fi
  enable_watchdog_service
  printf '5tratMux %s installation verified; desired power was preserved. Trial status was not changed.\n' "${version}"
}

rollback_release() {
  require_root
  require_commands
  write_status "rolling_back" "Restoring the previous verified 5tratMux release" ""
  docker image inspect 5tratmux:rollback >/dev/null 2>&1 \
    || die "no rollback image is available"
  ensure_config
  configured_dns_servers >/dev/null || die "saved DNS settings are invalid; the installed version was not changed"
  restore_interrupted_install
  local rollback_channel backup_name=""
  rollback_channel="$(
    docker image inspect \
      --format '{{ index .Config.Labels "com.5tratumos.channel" }}' \
      5tratmux:rollback 2>/dev/null || true
  )"
  rollback_channel="${rollback_channel:-DEV}"
  if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    # Keep the current release until the rollback image proves itself.
    docker stop "${CONTAINER_NAME}" >/dev/null \
      || die "could not stop the current container; rollback was not applied"
    backup_name="${CONTAINER_NAME}-previous-$(date +%s)"
    docker rename "${CONTAINER_NAME}" "${backup_name}" \
      || die "could not preserve the current container for restoration"
  fi
  if ! activate_release 5tratmux:rollback "${rollback_channel}"; then
    restore_previous_container "${backup_name}" "rollback" || return 1
    if [[ -n "${backup_name}" ]]; then
      die "rollback image failed runtime verification; the current release was restored without changing desired power"
    fi
    die "rollback image failed runtime verification"
  fi
  if [[ -n "${backup_name}" ]]; then
    docker container rm "${backup_name}" >/dev/null
  fi
  if power_desired_on; then
    write_status "healthy" "The previous verified 5tratMux release is healthy" "$(installed_version)"
  else
    hold_powered_off || return 1
  fi
  printf '5tratMux rollback verified; desired power was preserved.\n'
}

check_release() {
  require_commands
  write_status "checking" "Checking the signed 5tratMux release channel" ""
  write_public_key
  local work available installed
  new_work_dir
  work="${UPDATER_WORK_DIR}"
  download_manifest "${work}"
  available="$(manifest_value "${work}/manifest.json" version)"
  installed="$(installed_version)"
  cleanup_work_dir
  printf 'Installed: %s\nAvailable: %s\n' "${installed}" "${available}"
  if [[ "${installed}" = "not-installed" ]] \
    || [[ "$(version_key "${available}")" > "$(version_key "${installed}")" ]]; then
    write_status "update_available" "5tratMux ${available} is ready to install" "${available}"
    printf 'Update available.\n'
    return 10
  fi
  write_status "current" "5tratMux ${installed} is current" "${installed}"
  printf '5tratMux is current.\n'
}

status_release() {
  local installed state
  installed="$(installed_version)"
  state="stopped"
  if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    state="$(
      docker container inspect --format '{{.State.Status}}' "${CONTAINER_NAME}"
    )"
  fi
  printf '5tratMux %s · %s\n' "${installed}" "${state}"
}

bootstrap_release() {
  require_root
  require_commands
  ensure_config
  restore_interrupted_install
  local installed
  installed="$(installed_version)"
  if ! power_desired_on; then
    hold_powered_off || return 1
    printf '5tratMux remains powered off. Settings, licence and saved routes were preserved.\n'
    return 0
  fi
  if [[ "${installed}" != "not-installed" ]]; then
    if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
      docker update --restart=unless-stopped "${CONTAINER_NAME}" >/dev/null
      docker start "${CONTAINER_NAME}" >/dev/null
    fi
    write_status \
      "starting" \
      "5tratMux ${installed} is installed and starting; licence and saved routes are unchanged" \
      "${installed}"
    enable_watchdog_service
    printf '5tratMux %s is already installed. Trial status was not changed.\n' \
      "${installed}"
    return 0
  fi
  install_release
}

health_ready() {
  curl --fail --silent --show-error --connect-timeout 3 --max-time 8 "${HEALTH_URL}" >/dev/null 2>&1
}

updater_busy() {
  if [[ -r "${STATUS_FILE}" ]] && command -v python3 >/dev/null 2>&1; then
    python3 - "${STATUS_FILE}" <<'PY' >/dev/null 2>&1
import json
import sys
from datetime import datetime, timezone
try:
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        payload = json.load(handle)
    updated = str(payload.get("updatedAt") or "").replace("Z", "+00:00")
    age = 10**9
    if updated:
        stamp = datetime.fromisoformat(updated)
        if stamp.tzinfo is None:
            stamp = stamp.replace(tzinfo=timezone.utc)
        age = (datetime.now(timezone.utc) - stamp).total_seconds()
    raise SystemExit(0 if bool(payload.get("busy")) and age < 1800 else 1)
except Exception:
    raise SystemExit(1)
PY
    return $?
  fi
  return 1
}

watchdog_log() {
  logger --tag 5tratmux-watchdog -- "$*" 2>/dev/null || true
  printf '5tratMux watchdog: %s\n' "$*"
}

watchdog_wait_for_health() {
  local attempt
  for attempt in {1..15}; do
    health_ready && return 0
    sleep 2
  done
  return 1
}

watchdog_reinstall_allowed() {
  local stamp now last
  stamp="${WATCHDOG_STATE_DIR}/last-reinstall"
  now="$(date +%s)"
  last=0
  if [[ -r "${stamp}" ]]; then
    read -r last < "${stamp}" || last=0
  fi
  [[ "${last}" =~ ^[0-9]+$ ]] || last=0
  (( now - last >= WATCHDOG_REINSTALL_COOLDOWN ))
}

watchdog_mark_reinstall() {
  install -d -m 0755 "${WATCHDOG_STATE_DIR}"
  date +%s > "${WATCHDOG_STATE_DIR}/last-reinstall"
  chmod 0644 "${WATCHDOG_STATE_DIR}/last-reinstall"
}

watchdog_once() {
  if ! power_desired_on; then
    hold_powered_off || return 1
    return 0
  fi
  health_ready && return 0
  updater_busy && {
    watchdog_log "installation or update is active; health repair deferred"
    return 0
  }

  # Confirm the failure before disturbing a working route.
  sleep 5
  health_ready && return 0

  restore_interrupted_install
  local container=""
  if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
    container="${CONTAINER_NAME}"
  fi
  if [[ -z "${container}" ]]; then
    watchdog_log "runtime is absent; starting signed bootstrap"
    bootstrap_release || return 1
    watchdog_wait_for_health
    return $?
  fi

  watchdog_log "${container} is unhealthy; restarting its service"
  docker restart --time 20 "${container}" >/dev/null || true
  if watchdog_wait_for_health; then
    watchdog_log "${container} recovered after restart"
    return 0
  fi

  if ! watchdog_reinstall_allowed; then
    watchdog_log "restart did not restore health; signed reinstall is rate-limited"
    return 1
  fi
  watchdog_mark_reinstall
  watchdog_log "restart did not restore health; repairing from the signed release"
  install_release || return 1
  watchdog_wait_for_health
}

watchdog_release() {
  require_root
  require_commands
  [[ "${WATCHDOG_INTERVAL}" =~ ^[0-9]+$ ]] || WATCHDOG_INTERVAL=120
  (( WATCHDOG_INTERVAL >= 30 )) || WATCHDOG_INTERVAL=30
  watchdog_log "service monitor started with a ${WATCHDOG_INTERVAL}s interval"
  while true; do
    with_lifecycle_lock watchdog_once || true
    sleep "${WATCHDOG_INTERVAL}"
  done
}

case "${1:---check}" in
  --check) check_release ;;
  --install|--update)
    if [[ $# -ge 2 ]]; then
      [[ $# -eq 2 && "$2" = "--allow-downgrade" ]] || die "usage: $1 [--allow-downgrade]"
      ALLOW_DOWNGRADE=1
    fi
    with_lifecycle_lock install_release
    ;;
  --install-bundle)
    if [[ $# -eq 3 && "$3" = "--allow-downgrade" ]]; then
      ALLOW_DOWNGRADE=1
      set -- "$1" "$2"
    fi
    [[ $# -eq 2 && -n "$2" && -d "$2" ]] || die "usage: --install-bundle DIRECTORY [--allow-downgrade]"
    with_lifecycle_lock --wait-bundle install_release "$2"
    ;;
  --bootstrap) with_lifecycle_lock bootstrap_release ;;
  --watchdog) watchdog_release ;;
  --rollback) with_lifecycle_lock rollback_release ;;
  --status) status_release ;;
  --help|-h)
    printf 'Usage: %s --check|--install [--allow-downgrade]|--install-bundle DIRECTORY [--allow-downgrade]|--bootstrap|--watchdog|--rollback|--status\n' "$0"
    ;;
  *) die "unknown option: $1" ;;
esac
